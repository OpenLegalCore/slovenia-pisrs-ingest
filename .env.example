# PostgreSQL DSN; supply real credentials only in a private environment file.
PISRS_DATABASE_DSN=<required-postgresql-dsn>
# Explicit database identity; it must match both the DSN and current_database().
PISRS_EXPECTED_DATABASE=<required-database-name>
# Qdrant REST endpoint and the fixed compatible collection.
PISRS_QDRANT_URL=<required-qdrant-http-or-https-url>
PISRS_QDRANT_COLLECTION=pisrs_current
# PISRS API base and private API token.
PISRS_PORTAL_BASE_URL=<required-pisrs-https-api-base>
PISRS_API_TOKEN=<required-private-pisrs-token>
# Embedding provider configuration.
OPENAI_API_KEY=<required-private-embedding-api-key>
OPENAI_BASE_URL=<required-embedding-https-api-base>
PISRS_EMBEDDING_MODEL=text-embedding-3-large
PISRS_EMBEDDING_DIMENSIONS=3072
# Writable paths owned by the service user.
PISRS_CHECKPOINT_PATH=/var/lib/pisrs-ingest/checkpoint.json
PISRS_LOCK_PATH=/run/pisrs-ingest/ingest.lock
# Required first interval boundary; use an explicit UTC timestamp.
PISRS_INITIAL_SINCE=<required-iso-8601-utc-timestamp>
# Explicit safety limits.
PISRS_MAX_DOCUMENTS_PER_RUN=<reviewed-positive-integer>
PISRS_EMBED_BATCH_SIZE=<reviewed-positive-integer>
PISRS_MAX_EMBEDDING_INPUT_BYTES_PER_RUN=5000000
PISRS_RECONCILE_MAX_CHANGES=<reviewed-positive-integer>
# Mutating commands require PISRS_ALLOW_WRITES=1. Nightly also requires external access.
PISRS_ALLOW_EXTERNAL_API=0
PISRS_ALLOW_WRITES=0
